    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.19.19",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/fzf-completion.ts"
    ]
